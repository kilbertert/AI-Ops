# 将值复制到密钥管理器或 shell 环境中；不要提交密码。

# 可选的便携路径覆盖；留空则使用平台默认路径。
# Windows 默认路径为 %LOCALAPPDATA%\AI-Ops-Diagnostics。
# Linux 默认路径为 ~/.config/aiops-diagnostics 和 ~/.local/share/aiops-diagnostics。
AIOPS_HOME=
AIOPS_CONFIG_HOME=
AIOPS_DATA_HOME=
AIOPS_CONFIG_FILE=

# MySQL 业务数据库（PRD #23 权限上下文 + 受限直连）。
# scoped 直连使用最小只读账号 aiops_ro（GRANT SELECT 于 cloud_charging_pile/qumall_upms），
# 经 SSH 跳板隧道到生产 MySQL；旧 diagnostic_readonly MySQL 账号从未在生产库存在，已退役。
# ScopeContext/QueryScope 生效时，裸 tenant_id 不被信任，租户/站点/用户范围以 SQL 谓词下推。
AIOPS_MYSQL_HOST=127.0.0.1
AIOPS_MYSQL_PORT=3306
AIOPS_MYSQL_USER=aiops_ro
AIOPS_MYSQL_PASSWORD=
AIOPS_MYSQL_DATABASE=cloud_charging_pile

# TDengine 只读代理；生产诊断不要直接指向 OSS REST 接口。
# 16041 是跳板机上 aiops_tdengine_proxy 受控代理；USER/PASSWORD 为代理 client
# 凭据（代理侧校验），不是 TDengine 用户；上游由代理以独立最小账号转发。
AIOPS_TDENGINE_URL=http://127.0.0.1:16041
AIOPS_TDENGINE_USER=diagnostic_readonly
AIOPS_TDENGINE_PASSWORD=
AIOPS_TDENGINE_DATABASE=iot

# 订单同步 Redis（PRD #23 受限直连）。使用最小权限 ACL 用户 diagnostic_readonly：
# 仅白名单 third.order.sync.* 流的只读命令（XLEN/XINFO/XREVRANGE/TYPE/PING/INFO），
# 密码 2026-09-01 已轮换；T4 归属谓词只统计租户可验证消息，不返回原始正文。
AIOPS_REDIS_HOST=127.0.0.1
AIOPS_REDIS_PORT=6379
AIOPS_REDIS_DATABASE=0
AIOPS_REDIS_USER=diagnostic_readonly
AIOPS_REDIS_PASSWORD=

# DEPRECATED（PRD #23 2026-08-31 起 /diag/* HTTP 方案不再是基线，保留仅作回退参考）：
# 充电业务诊断查询接口（/diag/*）；内部令牌密钥不能提交到仓库。
# 默认诊断路径已改为受限直连（ScopedSources），不再依赖本段配置。
# 但两个源集合并存，这段并非纯历史：标准 API 面（/v1/diagnoses，调用者身份已解析出
# 租户）传 scope 走 ScopedSources，租户以 SQL 谓词下推；设备运行路径（POST /v1/runs）
# 不传 scope，落到 live_sources → HybridSources，订单仍经 /diag/* HTTP 读取，租户由
# 工具层按行后过滤。设备路径没有 SQL 可下推，这正是两套源集合并存的原因，也决定了
# 租户规则只能有一处定义（order_visibility.py）、两种渲染。因此对外提供设备诊断的
# Gateway 仍需打开下面这段；只服务标准 API 面的部署可以不配。
# AIOPS_HTTP_BASE_URL=http://127.0.0.1:8080
# AIOPS_HTTP_INTERNAL_TOKEN_SECRET=
# AIOPS_HTTP_INTERNAL_TOKEN_EXPIRE_SECONDS=300
# AIOPS_HTTP_TIMEOUT_SECONDS=8
# 兼容旧变量名（新部署使用上面的变量；未设置 AIOPS_HTTP_* 时才回退读取）：
# AIOPS_DIAG_API_BASE_URL=http://127.0.0.1:8080
# AIOPS_DIAG_API_TOKEN_SECRET=
# AIOPS_DIAG_API_TOKEN_EXPIRE_SECONDS=300
# AIOPS_DIAG_API_TIMEOUT_SECONDS=8

# 平台 UPMS 只读服务；诊断运行用它解析调用者身份、角色权限和业务数据范围。
# 调用者平台凭证由运维入口透传，不在本文件配置。
AIOPS_UPMS_BASE_URL=
AIOPS_UPMS_TIMEOUT_SECONDS=8

# 平台 Dis 点位归属服务；代查目标主体时把 C 端用户点位解析为站点范围。
# TOKEN 为充电桩 Java DisFeignInterceptor 同款服务侧静态令牌，非用户凭证，
# 仅在服务端配置，绝不进入审计摘要或错误消息。
AIOPS_DIS_BASE_URL=
AIOPS_DIS_TOKEN=
AIOPS_DIS_TIMEOUT_SECONDS=8

# 可选 SSH 本地转发；有意不支持密码认证。
AIOPS_SSH_ENABLED=false
AIOPS_SSH_BIN=ssh
AIOPS_SSH_HOST=
AIOPS_SSH_PORT=22
AIOPS_SSH_USER=diagnostic
AIOPS_SSH_KEY_FILE=
AIOPS_SSH_MYSQL_HOST=
AIOPS_SSH_MYSQL_PORT=3306
AIOPS_SSH_REDIS_HOST=
AIOPS_SSH_REDIS_PORT=6379
AIOPS_SSH_TDENGINE_HOST=127.0.0.1
AIOPS_SSH_TDENGINE_PORT=16041

# 安全上限
AIOPS_QUERY_TIMEOUT_SECONDS=8
AIOPS_TDENGINE_MAX_ROWS=2000
AIOPS_MAX_ORDER_WINDOW_HOURS=72

# Codex-native 诊断 agent；API key 永远不能提交到仓库。
# 留空 AIOPS_CODEX_BIN，使用 Python SDK 固定版本的原生 Codex runtime。
AIOPS_CODEX_BIN=
AIOPS_CODEX_BASE_URL=https://api.psydo.top/
AIOPS_CODEX_API_KEY_ENV=AIOPS_CODEX_API_KEY
# 可选的一次性密钥来源；需要重复运行时优先使用私有 key slot。
AIOPS_CODEX_API_KEY_FILE=
AIOPS_CODEX_KEY_DIR=
AIOPS_CODEX_KEY_SLOT=default
AIOPS_CODEX_RUNTIME_HOME=
AIOPS_AGENT_RUN_ROOT=
AIOPS_AGENT_MODEL=
# 多 provider 注册表（推荐）。留空 AIOPS_PROVIDERS 则回退到上面的单 provider 遗留配置。
# 每个 provider 需要 BASE_URL；MODEL/KEY_ENV/KEY_SLOT/WIRE_API 可选，默认 wire_api=responses、
# key_slot=provider 名称。所有 provider 的 Codex 侧 env_key 统一为 AIOPS_CODEX_PROVIDER_KEY。
# AIOPS_PROVIDERS=glm-ark,gpt-psydo
# AIOPS_DEFAULT_PROVIDER=glm-ark
# AIOPS_PROVIDER_GLM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3/
# AIOPS_PROVIDER_GLM_ARK_MODEL=glm-5-2-260617
# AIOPS_PROVIDER_GLM_ARK_KEY_ENV=AIOPS_PROVIDER_GLM_ARK_KEY
# AIOPS_PROVIDER_GLM_ARK_KEY_SLOT=glm-ark
# AIOPS_PROVIDER_GPT_PSYDO_BASE_URL=https://api.psydo.top/
# AIOPS_PROVIDER_GPT_PSYDO_KEY_SLOT=psydo-primary
AIOPS_AGENT_MAX_TURNS=8
AIOPS_AGENT_MAX_TOOL_CALLS=16
AIOPS_AGENT_MAX_VALIDATION_RETRIES=2
AIOPS_AGENT_TURN_TIMEOUT_SECONDS=600
# Codex 长 turn 的可见心跳间隔（秒），同时写入私有 events.jsonl。
AIOPS_AGENT_HEARTBEAT_INTERVAL_SECONDS=10
# Windows 便携版默认使用无需管理员权限的 restricted-token sandbox。
AIOPS_WINDOWS_SANDBOX=unelevated

# 中央 AI-Ops Gateway（客户端不保存数据库凭据）
AIOPS_GATEWAY_URL=
AIOPS_GATEWAY_TOKEN_STORE=auto

# 仅 Gateway 服务端使用：数据库、SSH 和 provider 配置仍只在服务器私有配置中读取。
AIOPS_GATEWAY_DATA_HOME=
AIOPS_GATEWAY_DATABASE_FILE=
AIOPS_GATEWAY_BIND=127.0.0.1
AIOPS_GATEWAY_PORT=8787
AIOPS_GATEWAY_SERVER_CONFIG_FILE=
AIOPS_GATEWAY_ALLOW_FIXTURES=false
AIOPS_GATEWAY_MAX_WORKERS=2
AIOPS_GATEWAY_ALLOWED_KEY_SLOTS=primary,backup
AIOPS_GATEWAY_EVENT_POLL_SECONDS=0.5

# 标准资源 API 的 OAuth 2.0 token introspection（不影响既有 aops_ 设备接口）。
# 远程 endpoint 必须使用 HTTPS；client secret 只放服务器私有 production.env。
AIOPS_GATEWAY_INTROSPECTION_URL=
AIOPS_GATEWAY_INTROSPECTION_CLIENT_ID=
AIOPS_GATEWAY_INTROSPECTION_CLIENT_SECRET=
AIOPS_GATEWAY_STANDARD_API_AUDIENCE=aiops-api
AIOPS_GATEWAY_INTROSPECTION_TIMEOUT_SECONDS=5
# Java/BFF service credential for direct thirdSession Redis resolution.
AIOPS_GATEWAY_THIRD_SESSION_SERVICE_TOKEN=
# Must match Java MallConstants.THIRD_SESSION_BEGIN, including the trailing colon.
AIOPS_GATEWAY_THIRD_SESSION_KEY_PREFIX=app:3rd_session:
# kb-service search endpoint for the customer QA RAG path (T3/#170).
# Route B joint-debug base URL; leave empty to disable the RAG path (plain zero-order answers).
AIOPS_GATEWAY_KB_SERVICE_BASE_URL=
AIOPS_GATEWAY_KB_SERVICE_TIMEOUT_SECONDS=10
# HMAC secret for short-lived media resource signing; required (with the KB URL) to enable media blocks.
AIOPS_GATEWAY_MEDIA_SIGNING_SECRET=
AIOPS_GATEWAY_MEDIA_TTL_SECONDS=600
