# 将值复制到密钥管理器或 shell 环境中；不要提交密码。

# 可选的便携路径覆盖；留空则使用平台默认路径。
# Windows 默认路径为 %LOCALAPPDATA%\AI-Ops-Diagnostics。
# Linux 默认路径为 ~/.config/aiops-diagnostics 和 ~/.local/share/aiops-diagnostics。
AIOPS_HOME=
AIOPS_CONFIG_HOME=
AIOPS_DATA_HOME=
AIOPS_CONFIG_FILE=

# MySQL 业务数据库
AIOPS_MYSQL_HOST=127.0.0.1
AIOPS_MYSQL_PORT=3306
AIOPS_MYSQL_USER=diagnostic_readonly
AIOPS_MYSQL_PASSWORD=
AIOPS_MYSQL_DATABASE=cloud_charging_pile

# TDengine 只读代理；生产诊断不要直接指向 OSS REST 接口。
AIOPS_TDENGINE_URL=http://127.0.0.1:16041
AIOPS_TDENGINE_USER=diagnostic_readonly
AIOPS_TDENGINE_PASSWORD=
AIOPS_TDENGINE_DATABASE=iot

# 充电服务使用的 Redis
AIOPS_REDIS_HOST=127.0.0.1
AIOPS_REDIS_PORT=6379
AIOPS_REDIS_DATABASE=0
AIOPS_REDIS_USER=
AIOPS_REDIS_PASSWORD=

# 可选 SSH 本地转发；有意不支持密码认证。
AIOPS_SSH_ENABLED=false
AIOPS_SSH_BIN=ssh
AIOPS_SSH_HOST=
AIOPS_SSH_PORT=22
AIOPS_SSH_USER=diagnostic
AIOPS_SSH_KEY_FILE=
AIOPS_SSH_MYSQL_HOST=127.0.0.1
AIOPS_SSH_MYSQL_PORT=3306
AIOPS_SSH_TDENGINE_HOST=127.0.0.1
AIOPS_SSH_TDENGINE_PORT=16041
AIOPS_SSH_REDIS_HOST=127.0.0.1
AIOPS_SSH_REDIS_PORT=6379

# 安全上限
AIOPS_QUERY_TIMEOUT_SECONDS=8
AIOPS_MYSQL_MAX_EXECUTION_MS=3000
AIOPS_TDENGINE_MAX_ROWS=2000
AIOPS_REDIS_MAX_MESSAGES=200
AIOPS_MAX_ORDER_WINDOW_HOURS=72

# Codex-native 诊断 agent；API key 永远不能提交到仓库。
# 留空 AIOPS_CODEX_BIN，使用 Python SDK 固定版本的原生 Codex runtime。
AIOPS_CODEX_BIN=
AIOPS_CODEX_BASE_URL=https://api.psydo.top/
AIOPS_CODEX_API_KEY_ENV=AIOPS_CODEX_API_KEY
# 可选的一次性密钥来源；需要重复运行时优先使用私有 key slot。
AIOPS_CODEX_API_KEY_FILE=
AIOPS_CODEX_KEY_DIR=
AIOPS_CODEX_KEY_SLOT=default
AIOPS_CODEX_RUNTIME_HOME=
AIOPS_AGENT_RUN_ROOT=
AIOPS_AGENT_MODEL=
AIOPS_AGENT_MAX_TURNS=8
AIOPS_AGENT_MAX_TOOL_CALLS=16
AIOPS_AGENT_MAX_VALIDATION_RETRIES=2
AIOPS_AGENT_TURN_TIMEOUT_SECONDS=600
# Codex 长 turn 的可见心跳间隔（秒），同时写入私有 events.jsonl。
AIOPS_AGENT_HEARTBEAT_INTERVAL_SECONDS=10
# Windows 便携版默认使用无需管理员权限的 restricted-token sandbox。
AIOPS_WINDOWS_SANDBOX=unelevated

# 中央 AI-Ops Gateway（客户端不保存数据库凭据）
AIOPS_GATEWAY_URL=
AIOPS_GATEWAY_TOKEN_STORE=auto

# 仅 Gateway 服务端使用：数据库、SSH 和 provider 配置仍只在服务器私有配置中读取。
AIOPS_GATEWAY_DATA_HOME=
AIOPS_GATEWAY_DATABASE_FILE=
AIOPS_GATEWAY_BIND=127.0.0.1
AIOPS_GATEWAY_PORT=8787
AIOPS_GATEWAY_SERVER_CONFIG_FILE=
AIOPS_GATEWAY_ALLOW_FIXTURES=false
AIOPS_GATEWAY_MAX_WORKERS=2
AIOPS_GATEWAY_ALLOWED_KEY_SLOTS=primary,backup
AIOPS_GATEWAY_EVENT_POLL_SECONDS=0.5
