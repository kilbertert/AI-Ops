# 将值复制到密钥管理器或 shell 环境中；不要提交密码。
#
# Gateway 设置的来源规则只有一条（#973）：进程 env 缺失 ⇒ 私有 production.env
# （`AIOPS_GATEWAY_SERVER_CONFIG_FILE` 指向的 0600 文件）⇒ 默认值。键**存在**就
# 是值 —— `KEY=` 的空串覆盖文件里的同名行，不再向下回退。行尾标 `# 仅进程环境`
# 的键不读 production.env：写进那份文件**静默不生效**，只能给进程环境（gateway.env）。
# 「哪个字段走哪条」的唯一权威是 gateway_config.SETTING_SOURCES，本文件与其逐键对应。

# 可选的便携路径覆盖；留空则使用平台默认路径。
# Windows 默认路径为 %LOCALAPPDATA%\AI-Ops-Diagnostics。
# Linux 默认路径为 ~/.config/aiops-diagnostics 和 ~/.local/share/aiops-diagnostics。
AIOPS_HOME=
AIOPS_CONFIG_HOME=
AIOPS_DATA_HOME=
AIOPS_CONFIG_FILE=

# MySQL 业务数据库（PRD #23 权限上下文 + 受限直连）。
# scoped 直连使用最小只读账号 aiops_ro（GRANT SELECT 于 cloud_charging_pile/qumall_upms），
# 经 SSH 跳板隧道到生产 MySQL；旧 diagnostic_readonly MySQL 账号从未在生产库存在，已退役。
# ScopeContext/QueryScope 生效时，裸 tenant_id 不被信任，租户/站点/用户范围以 SQL 谓词下推。
AIOPS_MYSQL_HOST=127.0.0.1
AIOPS_MYSQL_PORT=3306
AIOPS_MYSQL_USER=aiops_ro
AIOPS_MYSQL_PASSWORD=
AIOPS_MYSQL_DATABASE=cloud_charging_pile
# 离线分析解释业务DATETIME的已核对IANA时区；未配置则拒绝新分析
AIOPS_MYSQL_TIMEZONE=

# TDengine 只读代理；生产诊断不要直接指向 OSS REST 接口。
# 16041 是跳板机上 aiops_tdengine_proxy 受控代理；USER/PASSWORD 为代理 client
# 凭据（代理侧校验），不是 TDengine 用户；上游由代理以独立最小账号转发。
AIOPS_TDENGINE_URL=http://127.0.0.1:16041
AIOPS_TDENGINE_USER=diagnostic_readonly
AIOPS_TDENGINE_PASSWORD=
AIOPS_TDENGINE_DATABASE=iot

# 订单同步 Redis（PRD #23 受限直连）。使用最小权限 ACL 用户 diagnostic_readonly：
# 仅白名单 third.order.sync.* 流的只读命令（XLEN/XINFO/XREVRANGE/TYPE/PING/INFO），
# 密码 2026-09-01 已轮换；T4 归属谓词只统计租户可验证消息，不返回原始正文。
AIOPS_REDIS_HOST=127.0.0.1
AIOPS_REDIS_PORT=6379
AIOPS_REDIS_DATABASE=0
AIOPS_REDIS_USER=diagnostic_readonly
AIOPS_REDIS_PASSWORD=

# 平台 UPMS 只读服务；诊断运行用它解析调用者身份、角色权限和业务数据范围。
# 调用者平台凭证由运维入口透传，不在本文件配置。
AIOPS_UPMS_BASE_URL=
AIOPS_UPMS_TIMEOUT_SECONDS=8
# 服务侧内部调用凭据（#424）：AIOPS_UPMS_INSIDE_TOKEN 用于会话身份的 C→B 映射
# （GET /user/inside/byUserId/{userId}）。它与调用者平台凭证是两回事，
# 只在私有 production.env 里取值，模板不落值；未配置时管家端身份补全按
# fail closed 拒绝，消费者端行为不变。

# 平台 Dis 点位归属服务；代查目标主体时把 C 端用户点位解析为站点范围。
# TOKEN 为充电桩 Java DisFeignInterceptor 同款服务侧静态令牌，非用户凭证，
# 仅在服务端配置，绝不进入审计摘要或错误消息。
AIOPS_DIS_BASE_URL=
AIOPS_DIS_TOKEN=
AIOPS_DIS_TIMEOUT_SECONDS=8

# 可选 SSH 本地转发；有意不支持密码认证。
AIOPS_SSH_ENABLED=false
AIOPS_SSH_BIN=ssh
AIOPS_SSH_HOST=
AIOPS_SSH_PORT=22
AIOPS_SSH_USER=diagnostic
AIOPS_SSH_KEY_FILE=
AIOPS_SSH_MYSQL_HOST=
AIOPS_SSH_MYSQL_PORT=3306
AIOPS_SSH_REDIS_HOST=
AIOPS_SSH_REDIS_PORT=6379
AIOPS_SSH_TDENGINE_HOST=127.0.0.1
AIOPS_SSH_TDENGINE_PORT=16041

# 安全上限
AIOPS_QUERY_TIMEOUT_SECONDS=8
AIOPS_TDENGINE_MAX_ROWS=2000
AIOPS_MAX_ORDER_WINDOW_HOURS=72

# 现役语义分类/聚合说明的一次性模型请求；凭据仅存私有配置。
# 既有部署保留 AIOPS_CODEX_* 的密钥/端点键名，不再启动 Codex。
AIOPS_CODEX_BASE_URL=https://api.psydo.top/
AIOPS_CODEX_API_KEY_ENV=AIOPS_CODEX_API_KEY
AIOPS_CODEX_API_KEY_FILE=
AIOPS_CODEX_KEY_DIR=
AIOPS_CODEX_KEY_SLOT=default
AIOPS_AGENT_MODEL=
# 多 provider 注册表：仅使用选定项；不自动切供应商或切执行引擎。
# AIOPS_PROVIDERS=primary
# AIOPS_DEFAULT_PROVIDER=primary
# AIOPS_PROVIDER_PRIMARY_BASE_URL=https://model.example/v1/
# AIOPS_PROVIDER_PRIMARY_MODEL=
# AIOPS_PROVIDER_PRIMARY_KEY_ENV=AIOPS_MODEL_KEY
# AIOPS_PROVIDER_PRIMARY_WIRE_API=responses

# 仅 Gateway 服务端使用：数据库、SSH 和 provider 配置仍只在服务器私有配置中读取。
AIOPS_GATEWAY_DATA_HOME= # 仅进程环境
AIOPS_GATEWAY_DATABASE_FILE= # 仅进程环境
AIOPS_GATEWAY_BIND=127.0.0.1 # 仅进程环境
AIOPS_GATEWAY_PORT=8787 # 仅进程环境
AIOPS_GATEWAY_SERVER_CONFIG_FILE= # 仅进程环境
AIOPS_GATEWAY_ALLOW_FIXTURES=false # 仅进程环境
AIOPS_GATEWAY_MAX_WORKERS=2 # 仅进程环境

# 标准资源 API 的 OAuth 2.0 token introspection（不影响既有 aops_ 设备接口）。
# 远程 endpoint 必须使用 HTTPS；这组键（含 client secret）只读进程环境 —— 写进
# production.env 静默不生效，要写到 gateway.env 这类 EnvironmentFile 里。
AIOPS_GATEWAY_INTROSPECTION_URL= # 仅进程环境
AIOPS_GATEWAY_INTROSPECTION_CLIENT_ID= # 仅进程环境
AIOPS_GATEWAY_INTROSPECTION_CLIENT_SECRET= # 仅进程环境
AIOPS_GATEWAY_STANDARD_API_AUDIENCE=aiops-api # 仅进程环境
AIOPS_GATEWAY_INTROSPECTION_TIMEOUT_SECONDS=5 # 仅进程环境
# Java/BFF service credential for direct thirdSession Redis resolution.
AIOPS_GATEWAY_THIRD_SESSION_SERVICE_TOKEN=
# Must match Java MallConstants.THIRD_SESSION_BEGIN, including the trailing colon.
AIOPS_GATEWAY_THIRD_SESSION_KEY_PREFIX=app:3rd_session:
# Manager app (butler) identity via the company OAuth2 access token (#443 / ADR-0009).
# Validation goes to the company's own /oauth/check_token; this deployment holds the
# client credentials, the frontend never does. LEAVE ALL THREE EMPTY: that keeps the
# path unbuilt, so behaviour is unchanged (and clearing them is the rollback). Setting
# the URL without both credentials is a startup error, not a silent no-op.
# The URL must be https unless it is a loopback address.
AIOPS_GATEWAY_COMPANY_CHECK_TOKEN_URL=
AIOPS_GATEWAY_COMPANY_TOKEN_CLIENT_ID=
AIOPS_GATEWAY_COMPANY_TOKEN_CLIENT_SECRET=
# 入站来源密钥（#444 / ADR-0009 D8）。由**可信的那一跳**（公司网关）注入，前端不持有：
# 它是调用方**自报不了**的判据，也是两条信任模式之间唯一的分派依据。请求头为
# X-AIOps-Source-Key，必须由那一跳**覆盖式注入**（不是追加一个客户端也能伪造的头）。
# 留空 ⇒ 新链路整体不构造（fail closed，不是放行）；四项全部留空即与今天逐字一致，
# 清空本键就是回滚。只配密钥不配上面的校验入口是启动失败；密钥短于 16 字符也是
# 启动失败（对着可达入口，可枚举的密钥等于没有这道门）。
AIOPS_GATEWAY_COMPANY_SOURCE_KEY=
# 本地校验模式的签名密钥（#448）：配了它就不再调上游 check_token —— 与上面的
# CHECK_TOKEN_URL **互斥**（令牌有效性只能有一个权威，两个都配是启动失败）。
AIOPS_GATEWAY_COMPANY_JWT_KEY=
# 是否按公司自己的判据认管家端令牌（默认 true = 不验签、不判 exp，与公司一致）。
# 显式关闭的取值收全：0/false/no/off/disable/disabled 才算关，其它非空值都是开。
AIOPS_GATEWAY_COMPANY_TRUST_PAYLOAD=true
# kb-service search endpoint for the customer QA RAG path (T3/#170).
# Route B joint-debug base URL; leave empty to disable the RAG path (plain zero-order answers).
AIOPS_GATEWAY_KB_SERVICE_BASE_URL=
AIOPS_GATEWAY_KB_SERVICE_TIMEOUT_SECONDS=10 # 仅进程环境
# 每回合向知识库请求的 chunk 数上限（1..20）—— 客户问答、宣传卡片与 Dify 适配路由
# **共用这一个口径**。默认 10 是实测定的：`chunk_method=picture` 的知识库把图片块排在
# 中段（全部 chunk 挤在 0.185~0.201），k=5 时 16 种真实 query 形状里只有 5 种能取到
# 媒体块，k=10 是 12 种，k=15 以上不再增加。
AIOPS_GATEWAY_KB_SEARCH_MAX_RESULTS=10
# HMAC secret for short-lived media resource signing; required (with the KB URL) to enable media blocks.
AIOPS_GATEWAY_MEDIA_SIGNING_SECRET=
AIOPS_GATEWAY_MEDIA_TTL_SECONDS=600 # 仅进程环境
# 本网关**对外**的基地址（`https://host`，不带路径）。媒体 URL 默认是相对的
# `/v1/media/...`，因为 APP 与网关同源。但 `/v1/dify/retrieval` 返回的记录是交给
# **Dify** 的：相对路径在 Dify 页面上会被解析到 Dify 自己的主机（36 的 nginx 把
# `/v1` 转给 `api:5001`），每张图都 404。填了它，Dify 记录里的媒体 URL 变成绝对地址；
# 留空 = 保持相对路径（同源调用方的行为一字不变）。
AIOPS_GATEWAY_PUBLIC_BASE_URL=

# 面向 Dify 的知识检索适配路由（#581 / PRD #577）：Dify 控制台里给智能体挂「外接知识库」
# 时填的正是这一段。Dify 侧把 endpoint 拼成 `<endpoint>/retrieval`，所以端点填
# `https://<host>/v1/dify`，API Key 填下面那把密钥（与 PRODUCTION 链路凭据分离）。
# 两个键**全空 ⇒ 该路由整体 404**（未配置即不启用，不是「不需要凭据」）；只配一个是启动失败。
# 登记表决定 knowledge_id 对应**哪个租户、哪些知识库** —— Dify 没有租户概念，范围只能由我们定，
# 这是本路由不是「Dify 要什么就给什么」后门的唯一依据。
# 格式：`knowledge_id:tenant:kb1|kb2`，多行或分号分隔；非法/重复行是启动失败（不静默跳过）。
AIOPS_GATEWAY_DIFY_KNOWLEDGE_API_KEY=
AIOPS_GATEWAY_DIFY_KNOWLEDGE_BINDINGS=

# 自动登记（#925 / PRD #923）：已开户租户在 RAGFlow 名下的全部库以 `tenant-<tenant_id>`
# 直接可检索，不需要人工登记。默认开；人工登记永远优先，置 false 就是回滚。
AIOPS_GATEWAY_DIFY_KNOWLEDGE_AUTOREGISTER=true # 仅进程环境

# 调试身份（#586）：Dify 调试预览的专用凭据 + 固定测试租户 + 可用 knowledge_id 子集
# （逗号分隔）。三者成组配置；凭据不得与生产那把同值。全空 ⇒ 调试身份整体不存在。
AIOPS_GATEWAY_DIFY_DEBUG_API_KEY=
AIOPS_GATEWAY_DIFY_DEBUG_TENANT=
AIOPS_GATEWAY_DIFY_DEBUG_KNOWLEDGE_IDS=

# 试运行（POST /v1/dify/trial，#772/#781）：触发一次真实模型执行的专用凭据与固定调试
# 租户，必须成对，且凭据与其余每一把 Dify 钥匙都不同。全空 ⇒ 该路由整体 404。
AIOPS_GATEWAY_DIFY_TRIAL_API_KEY=
AIOPS_GATEWAY_DIFY_TRIAL_DEBUG_TENANT=

# 运营自助发布（POST /v1/dify/publish）的共享凭据；与检索/调试/试运行钥匙互不相同。
# 配它就必须同时配下面的控制台凭据（发布路由要用控制台凭据去拉 Dify）。
AIOPS_GATEWAY_DIFY_PUBLISH_API_KEY=

# 控制台导出端点凭据（#625）：aiops-admin pull-dify 用它把 Dify 里改好的配置拉回。
# 半配置（只给地址或只给 key）是启动失败；远程地址必须 HTTPS。
AIOPS_GATEWAY_DIFY_CONSOLE_BASE_URL=
AIOPS_GATEWAY_DIFY_CONSOLE_API_KEY=
# 导出请求要带的 workspace（admin-key 路径从它解析租户 owner）。留空 ⇒ 不带该头。
AIOPS_GATEWAY_DIFY_CONSOLE_WORKSPACE_ID=
# 该 workspace 的「外部知识库 API 模板」id（#1056）；建 external dataset 必须指名它。
AIOPS_GATEWAY_DIFY_EXTERNAL_KNOWLEDGE_API_ID=

# 本部署的**环境标识**（ADR-0059 / #879）。每台机器一个值（41、95…），落进
# `dify_workspaces.environment`，决定"这个租户的 workspace 是哪一本"。
# **起监听时必填、无默认值**：漏配或写成 `prod.41` 这类非规范形式（小写字母/数字/`-`/`_`，
# 以字母或数字开头结尾，≤32）时进程**拒绝启动**。判据与登录代理的
# `AIOPS_LOGIN_PROXY_ENVIRONMENT` 是同一份实现 —— 两个组件对"我在哪个环境"必须逐字相同。
AIOPS_GATEWAY_ENVIRONMENT=

# 网关**自己的**内部令牌密钥（HMAC-SHA256，`X-Internal-Token` + `X-Request-Timestamp`）。
# 目前唯一的消费者是 `GET /v1/dify/workspace`：登录代理与发布桥不在网关进程里，它们要问
# "这个租户的工作区是哪一个"就得有一把**进程间**凭据。留空 ⇒ 该端点整体 404。
# 它**不是** Dify 侧的钥匙，也不给 Dify。
AIOPS_GATEWAY_INTERNAL_TOKEN_SECRET=
AIOPS_GATEWAY_INTERNAL_TOKEN_EXPIRE_SECONDS=300

# 建 workspace 的唯一 HTTP 入口（Dify ``inner_api``，#880）。今天是 api 容器的内网
# ``IP:5001``（只有 36 本机能到），转发器上线后换成 ``http://127.0.0.1:15001`` ——
# 换的是这一行的值，不是代码。留空 ⇒ ``aiops admin ensure-workspace`` 拒绝运行。
# 开户还要用 ``AIOPS_GATEWAY_DIFY_CONSOLE_BASE_URL/_API_KEY`` 对账（all-workspaces 要 admin key）。
AIOPS_GATEWAY_DIFY_INNER_API_BASE_URL=
AIOPS_GATEWAY_DIFY_INNER_API_KEY=

# 让建出来的 workspace **能用**（#881 `aiops admin ensure-ready`）：它往每个新 workspace
# 里写一份自己的 provider 凭据。Dify 写的时候会拿它**当场打上游校验**，所以这里必须是真
# key —— 代码里没有默认值，也不该有。留空 ⇒ 该命令拒绝运行并点名这一行。
AIOPS_GATEWAY_DIFY_WORKSPACE_MODEL_API_KEY=
# 上面那把 key 对应的 endpoint；deepseek 官方端点是默认值。
AIOPS_GATEWAY_DIFY_WORKSPACE_MODEL_ENDPOINT=https://api.deepseek.com/v1

# Routing decisions from Jev's typed answers (PRD #383). Leave BOTH the base URL
# and the key empty to keep the previous model-based classifier — an unconfigured
# deployment is unchanged, not degraded. Setting only one is a startup error.
# The base URL must be https unless it is a loopback address.
# Where Jev's probabilities become the buckets the routing rule speaks in.
# These defaults come from the #390 calibration (docs/jev-threshold-calibration.md)
# and are expected to be re-measured against real traffic.
AIOPS_GATEWAY_ROUTING_RISK_AT_LEAST=0.5 # 仅进程环境
AIOPS_GATEWAY_ROUTING_CONFIDENCE_AT_LEAST=0.8 # 仅进程环境
# High risk asks for context regardless of confidence (2026-09-23). The previous
# "high risk AND not confident" form asked 0 times over 86 real questions, because
# Jev recognises money questions and is confident about recognising them.
# Set false to restore that form for comparison.
AIOPS_GATEWAY_ROUTING_RISK_ALWAYS_ASKS=true # 仅进程环境
# 会话上下文窗口（#482）：此前**已完成**的轮次里，有多少进入模型提示词，以及它们的
# token 预算。默认值就是对外合同里写的数字（8 轮 / 8000 token），不设即保持合同。
# 取值范围：轮数 1-50，token 100-100000；越界会显式报错，不会静默清空历史。
# 何时调小 token 预算：检索片段与宣传卡也要占模型的额度时，用这个旋钮让位，
# 而不是再写一份硬编码。# 中断/被取消的轮次本来就不进窗口，与此配置无关。
# 网关自身日志的最低级别（#636）。默认 INFO —— 就是代码一直假定的那一级。
# **在这一项存在之前，网关根本没配过 logging**：uvicorn 只给 `uvicorn*` 挂 handler，
# root 停在 WARNING 且无 handler，于是 `aiops.*` 的 INFO 行一行都没出去过（41 实测 0 行）；
# 能出去的那些 WARNING 走的是 Python 的 lastResort，形态是**不带级别前缀**的一行。
# 认 INFO/DEBUG/WARNING/ERROR/CRITICAL（大小写与首尾空格不敏感）；写错是**启动失败**，
# 不是静默落回默认 —— 否则"把日志打开了"会变成一句不成立的话。
AIOPS_GATEWAY_LOG_LEVEL=INFO # 仅进程环境

# C 端本人订单充电状态（默认关闭）。基础地址包含业务服务前缀，例如 https://cpms.example/charging-pile。
# 启用前确认与本 Gateway 的会话/订单授权源属于同一环境；只允许 HTTPS 或本机回环 HTTP。
AIOPS_GATEWAY_CHARGING_STATUS_BASE_URL=
# 平台已批准的业务环境清单（0600 JSON）。开通新客户的客户端客服时，若上面的地址没有登记
# 这个租户，就从这里取已批准的地址 —— 让"复制并开通"不再需要改本文件并重启网关。
# 上面的地址仍是权威覆盖；本项为空 ⇒ 与只配上面那条的行为逐字一致。
AIOPS_GATEWAY_BUSINESS_ENVIRONMENTS_FILE=
# 在现有客户端聊天中查询指定本人订单/本人最新一单，默认关闭；仍需上方地址及逻辑执行环境。
# 不借用 OPS 的整租户地址/服务 key，不启用模型或节点委派。
AIOPS_GATEWAY_CONSUMER_ORDER_CHAT_ENABLED=false
# 新运维工具必须用 tenant:https://base 的逗号登记表；旧标量仅供旧消费者/节点调用。
# 0600 私有服务绑定 JSON；缺省不启用 aiops-ops。密钥明文不放在此文件。
# 仅用于标识本部署的逻辑环境，不填写地址、凭据或真实客户名称。
AIOPS_GATEWAY_EXECUTION_ENVIRONMENT=
# M2-CLOSE-01：节点委派的可信绑定表（默认关闭）。指向一个 0600 的 JSON：
# 环境、Snail 应用/智能体、预期节点，以及**节点凭据的 sha256（不是凭据本身）**。
# 不设即整条委派入口 404；设了必须同时设上面两项业务接口与逻辑环境，否则启动失败。
AIOPS_GATEWAY_AGENT_RUN_CONFIG_FILE=
# M3：受控**执行配置清单**（默认空＝守卫不启用，行为与今天逐字一致）。指向一个 0600 的 JSON：
# schema=m3-exec-config/1、history_policy=none、model（provider/adapter/model_key/endpoint）、
# model_options、system_messages、tools（每项 name+description+input_schema）。
# 身份＝该文件**原始字节**的 sha256，与执行节点同算法 —— 所以两端必须拿到同一份字节。
# 配了就必须读得到且合格，否则启动失败（不降级）；配了它也必须配上面的委派绑定表。
# ⚠️ 无论是否配置它，Gateway 启动都会给 agent_runs 表补三列（ALTER TABLE），
#    部署前请确认旧库迁移与回滚路径（见 docs/validation.md 的同名小节）。
AIOPS_GATEWAY_EXECUTION_MANIFEST_FILE=
# APP-RUNTIME-01：现有 App 聊天的个人订单状态场景交给客户执行节点。
# 默认空 = 关闭（走原来的确定性直读）。指向一个 0600 的 JSON 登记表：
#   {"schema": "aiops-chat-execution/1",
#    "bindings": [{"environment": "<逻辑执行环境>", "tenant_id": "<租户>",
#                  "entry": "consumer", "scenario": "consumer_own_order_status",
#                  "config_file": "<0600 的执行配置>", "manifest_file": "<0600 的执行清单>"}]}
# **按租户登记**，不是"配一个全局文件"：没有这个租户的登记就走原直读、一次都不派发。
# 每条登记的 config/manifest 在启动时都要读得动且 environment 与登记一致，否则启动即拒。
# 聊天路线**必须**有清单：没有清单的 run 走旧协议（领取即 succeeded），会把
# 「只读了业务、整轮没跑完」记成成功。
# 不复用上面的 AGENT_RUN_*：委派入口与聊天入口是两条独立的启用路径。
AIOPS_GATEWAY_CHAT_EXECUTION_BINDINGS_FILE=
# Dify 路线的 Service API 基地址（https://dify.example，无路径）：只在登记表里至少
# 一条选了 engine:dify 时才必需；Dify 取数回调的地址不走这里（DSL 模板固定指回本网关）。
AIOPS_GATEWAY_DIFY_CHAT_BASE_URL=
# 管理表（chat_route_bindings）所在的 SQLite 文件；留空 ⇒ 不启用管理绑定，
# 发布/撤回没有地方落指针。与上面的文件登记表互斥声明同一条路线是启动失败。
AIOPS_GATEWAY_CHAT_ROUTE_BINDINGS_FILE=
# Dify app 的 Service API 凭据目录：<dir>/<app_id>.key，每 app 一把、0600。
# 一键开通会写入，必须位于服务可写的持久数据根（如 /var/lib/<服务>/dify-keys），
# 不放 /etc；已有正式路由保存的旧绝对路径需保留。发布只保存路径，不搬运凭据。
AIOPS_GATEWAY_CHAT_DIFY_KEY_DIR=
# 执行节点目标登记表（0600 JSON）。
AIOPS_GATEWAY_CHAT_NODE_TARGETS_FILE=

# WF01 Chatflow会话接线：先配置consumer_service登记；默认不启用。
AIOPS_GATEWAY_CONSUMER_CHATFLOW_ENABLED=0
# 客户端开通的知识插件版本来自所选来源发布图，不再另配全局插件版本。
# WF01发布目标：私有JSON声明应用/租户/环境/审核内容/知识库与只读能力。
# 仅有目标不启用App；发布冻结内容快照，配合既有管理路由与每应用Service key目录。
AIOPS_GATEWAY_CONSUMER_PUBLICATION_TARGETS_FILE=

# 平台一次性配置受管Java管家连接；租户通过Dify开通，不在这里逐个登记。
AIOPS_GATEWAY_OPERATOR_PROFILES_FILE=
# 管家试用入口：登录 URL 与 key 必须成对配置（半配是启动失败）；key ≥32 字符。
AIOPS_GATEWAY_OPERATOR_TRIAL_LOGIN_URL=
AIOPS_GATEWAY_OPERATOR_TRIAL_KEY=
# 时序数据门面（公司 tsdata 服务）的只读查询入口，cpms_charging_timeline 用它在授权
# 订单窗口内取枪遥测。空 = 该工具按依赖不可用拒绝，不静默退化为空页。
AIOPS_GATEWAY_OPERATOR_TSDATA_URL=
# 环境清单（ops/environments/<env>.toml）。运行时只用它的 [[channels]] 段：
# 哪一端的**使用渠道**已经接入。留空 ⇒ 每一端都显示"渠道待接入"（fail closed）。
# 不从"有应用/有正式版"推导渠道状态：那会把刚开通、还没人调它的客户显示成可用。
AIOPS_GATEWAY_ENVIRONMENT_MANIFEST_FILE=

# RAGFlow 一租户一租户（#924 / PRD #923）：开户把 RAGFlow owner 密码加密落库用的密钥
# （16/24/32 字节；留空 ⇒ 开户与轮换拒绝运行，而不是存明文）、账号邮箱域（派生
# sha1(tenant_id)[:16]@domain）、以及开户时一次真实 embedding 调用要用的端点/密钥/模型
# （校验存在的理由：密钥被供应商禁用的租户每份文档都解析失败，只读配置检查会判它健康）。
AIOPS_GATEWAY_RAGFLOW_CREDENTIAL_KEY=
AIOPS_GATEWAY_RAGFLOW_TENANT_DOMAIN=kb.internal # 仅进程环境
AIOPS_GATEWAY_RAGFLOW_EMBEDDING_BASE_URL=
AIOPS_GATEWAY_RAGFLOW_EMBEDDING_API_KEY=
AIOPS_GATEWAY_RAGFLOW_EMBEDDING_MODEL=text-embedding-3-large # 仅进程环境

# RAGFlow 控制台登录代理（#926）：登录代理要打的 RAGFlow API 地址（留空 ⇒ 控制台入口
# 整体 404）、浏览器最终要去的 web 入口（留空回落到 base URL）、密码 RSA 加密用的公钥
# 路径，以及会话 cookie 的 Domain —— 必须是网关与 RAGFlow 共同的父域；留空 ⇒ cookie 是
# host-only，跳到 RAGFlow 的源时浏览器一条 Cookie 头都不带（实测 40+ 请求全为 Cookie: -）。
AIOPS_GATEWAY_RAGFLOW_CONSOLE_BASE_URL=
AIOPS_GATEWAY_RAGFLOW_CONSOLE_PUBLIC_URL=
AIOPS_GATEWAY_RAGFLOW_CONSOLE_PUBLIC_PEM=
AIOPS_GATEWAY_RAGFLOW_CONSOLE_COOKIE_DOMAIN=
# 控制台一次性跳转票的有效秒数（#985）。
AIOPS_GATEWAY_KNOWLEDGE_HOP_TTL_SECONDS=60 # 仅进程环境
