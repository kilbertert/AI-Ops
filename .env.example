# Copy values into your secret manager or shell environment. Do not commit passwords.

# MySQL business database
AIOPS_MYSQL_HOST=127.0.0.1
AIOPS_MYSQL_PORT=3306
AIOPS_MYSQL_USER=diagnostic_readonly
AIOPS_MYSQL_PASSWORD=
AIOPS_MYSQL_DATABASE=cloud_charging_pile

# TDengine read-only proxy. Do not point production diagnostics at the OSS REST adapter directly.
AIOPS_TDENGINE_URL=http://127.0.0.1:16041
AIOPS_TDENGINE_USER=diagnostic_readonly
AIOPS_TDENGINE_PASSWORD=
AIOPS_TDENGINE_DATABASE=iot

# Redis used by charging services
AIOPS_REDIS_HOST=127.0.0.1
AIOPS_REDIS_PORT=6379
AIOPS_REDIS_DATABASE=0
AIOPS_REDIS_USER=
AIOPS_REDIS_PASSWORD=

# Optional SSH local forwarding. Password authentication is intentionally unsupported.
AIOPS_SSH_ENABLED=false
AIOPS_SSH_HOST=
AIOPS_SSH_PORT=22
AIOPS_SSH_USER=diagnostic
AIOPS_SSH_KEY_FILE=
AIOPS_SSH_MYSQL_HOST=127.0.0.1
AIOPS_SSH_MYSQL_PORT=3306
AIOPS_SSH_TDENGINE_HOST=127.0.0.1
AIOPS_SSH_TDENGINE_PORT=16041
AIOPS_SSH_REDIS_HOST=127.0.0.1
AIOPS_SSH_REDIS_PORT=6379

# Safety limits
AIOPS_QUERY_TIMEOUT_SECONDS=8
AIOPS_MYSQL_MAX_EXECUTION_MS=3000
AIOPS_TDENGINE_MAX_ROWS=2000
AIOPS_REDIS_MAX_MESSAGES=200
AIOPS_MAX_ORDER_WINDOW_HOURS=72

# Codex-native diagnostic agent. The API key is never committed.
AIOPS_CODEX_BIN=/home/claude/.local/bin/codex
AIOPS_CODEX_BASE_URL=https://api.psydo.top/
AIOPS_CODEX_API_KEY_ENV=AIOPS_CODEX_API_KEY
# Optional one-shot key source. Prefer a private key slot for repeatable runs.
AIOPS_CODEX_API_KEY_FILE=
AIOPS_CODEX_KEY_DIR=/home/claude/.config/aiops-diagnostics/keys
AIOPS_CODEX_KEY_SLOT=default
AIOPS_CODEX_RUNTIME_HOME=/home/claude/.local/share/aiops-diagnostics/codex-home
AIOPS_AGENT_RUN_ROOT=.aiops/runs
AIOPS_AGENT_MODEL=
AIOPS_AGENT_MAX_TURNS=8
AIOPS_AGENT_MAX_TOOL_CALLS=16
AIOPS_AGENT_MAX_VALIDATION_RETRIES=2
AIOPS_AGENT_TURN_TIMEOUT_SECONDS=600
