# Dify 1.17.1 @ 36 —— 实例级变量（#579 / PRD #577）
#
# 这份文件是**模板**：复制成 deploy/.env（与 compose 同目录，Dify 惯例）后再填。`.env` 已在 .gitignore 里（`.env`/`.env.*`），
# 里面是真实凭据，**永远不进仓**。
#
# 与上游 docker/.env.example 的关系：上游那份是"能起就行"的全量默认值。这一份是
# **按本实例裁剪**后的必需项 —— 上游默认值里凡是"开发环境专用但看起来像正式值"的
# 密钥（Dify 自己在注释里写了 Replace this development default in production），
# 这里一律留空并要求现场生成，避免把已知默认值带上生产。
#
# 生成随机值：
#   openssl rand -base64 42      # 密钥
#   openssl rand -hex 32         # 口令
#
# ---------------------------------------------------------------------------
# 一、镜像来源（Docker Hub 在 36 不可达）
# ---------------------------------------------------------------------------
# 只影响本栈：改这一行即整体切换来源，不需要动 dockerd（动 daemon 会重启 docker，
# 把 36 上跑着的生产栈一起抖）。见 README「镜像来源」。
DIFY_REGISTRY=docker.1panel.live

# ---------------------------------------------------------------------------
# 二、对外入口
# ---------------------------------------------------------------------------
# 36 已声明端口池 10000-10999；10008 是本栈新增分配。绑 0.0.0.0 是**刻意的**，
# 属已登记的临时暴露（无 TLS），收口路径见 README「暴露与收口」。
DIFY_EXPOSE_PORT=10008
# 浏览器要访问的地址。阶段 1 是公网 IP + 端口、无 TLS，所以这里填
# `http://36.156.159.175:10008`；收口成域名后改成 https 的那个。
CONSOLE_API_URL=http://36.156.159.175:10008
CONSOLE_WEB_URL=http://36.156.159.175:10008
SERVICE_API_URL=http://36.156.159.175:10008
APP_WEB_URL=http://36.156.159.175:10008
NEXT_PUBLIC_SOCKET_URL=ws://36.156.159.175:10008
# 服务端之间的地址不经过公网；保持容器名。
SERVER_CONSOLE_API_URL=http://api:5001

# ---------------------------------------------------------------------------
# 三、必须现场生成的口令与密钥（留空则实例起不来 / 用了不该用的默认值）
# ---------------------------------------------------------------------------
# Dify 的会话/加密根密钥。留空时 Dify 会在存储目录自动生成一个并持久化 ——
# 本实例**显式设置**，否则密钥随存储卷走，迁移时容易丢且无从核对。
SECRET_KEY=
# 初始管理员口令。首次打开控制台时用它建账号 —— 见 README「首次登录」。
INIT_PASSWORD=

# PostgreSQL
DB_TYPE=postgresql
DB_HOST=db_postgres
DB_PORT=5432
DB_USERNAME=dify
DB_PASSWORD=
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin

# Redis。**连接键必须显式给**：Dify 读不到这些变量时默认 `localhost`，而
# 容器里的 localhost 不是 redis 容器 —— 症状是 api 起不来、日志报 111 拒绝连接。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# plugin_daemon 与 api 之间的内网凭据
PLUGIN_DAEMON_KEY=
PLUGIN_DIFY_INNER_API_KEY=

# plugin_daemon 的远程调试监听。**必填**：GO 侧的配置校验把 host 当作 required，
# 缺了它容器直接 `invalid configuration: plugin remote installing host is empty` 起不来，
# 然后 endless restart。compose 已把它接进来（UPSTREAM 默认 0.0.0.0/5003）。
PLUGIN_DEBUGGING_HOST=0.0.0.0
PLUGIN_DEBUGGING_PORT=5003

# ---------------------------------------------------------------------------
# 四、本实例的形态决定
# ---------------------------------------------------------------------------
# 本实例是社区版自托管，不是 Dify Cloud。
DEPLOYMENT_EDITION=COMMUNITY
DEPLOY_ENV=PRODUCTION
MIGRATION_ENABLED=true

# 关掉插件市场（PRD #577 明确要求）。语义已核实：整条市场面的入口（列出/安装/
# 升级/下载）都先查这个开关，关掉即不可达。**注意它不阻止模型 provider 插件**：
# 模型侧走的是"上传本地 .difypkg"，与市场无关（两者在源码里是不同的权限检查）。
# 影响与代价见 README「被删掉的服务」与「插件市场关闭」。
MARKETPLACE_ENABLED=false

# 不做协作编辑 —— 因此**不需要 api_websocket 容器**，compose 里已删。
# 少了它，nginx 的 /socket.io/ 改指 api（compose 的 NGINX_SOCKET_IO_UPSTREAM）。
ENABLE_COLLABORATION_MODE=false

# 本实例不面向终端用户（最终用户入口仍是 AI-Ops 网关），所以关掉自助注册与
# 建工作区；账号由管理员建。
ALLOW_REGISTER=false
ALLOW_CREATE_WORKSPACE=false

# ---------------------------------------------------------------------------
# 五、SSRF 处置（PRD #577 要求"显式二选一并记录"）
# ---------------------------------------------------------------------------
# 选的是【保留 SSRF 过滤 + 显式加白名单】，不是清空 SSRF_PROXY_*。
#
# 机制（已核实到源码）：发行版 squid.conf 里
#     acl allowed_domains dstdomain .marketplace.dify.ai
#     http_access deny to_private_networks     <-- 私有网段一律先拒
#     http_access allow allowed_domains / client_localnet / localhost
#     http_access deny all                      <-- 兜底
# 而 ssrf_proxy 的 docker-entrypoint.sh 会把下面两个变量渲染成
#     acl <名> dst/dstdomain <值...>
#     http_access allow client_localnet <名>
# 插在 `deny to_private_networks` **之前** —— 这是唯一被支持的加白口子。
#
# 本实例当前**两者都留空**：Dify 侧还没有任何需要打私有地址的配置（#581 的
# External Knowledge API 要等运营在控制台里挂上才产生流量）。留空 = 过滤全开，
# 且与上游默认逐字一致。**等 #581 之后挂知识库时**，按目标地址二选一填入：
#   目标是我们网关域名（走公网）      → SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=api.mall.qushiyun.com
#   目标是 36 本机/内网地址           → SSRF_PROXY_ALLOW_PRIVATE_IPS=<CIDR>
#                                      （切记：squid 在容器里，127.0.0.1 指它自己）
# 只加**那一个**目标，不要为了省事写 0.0.0.0/0 或 10.0.0.0/8。
SSRF_PROXY_ALLOW_PRIVATE_IPS=
SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=

# ---------------------------------------------------------------------------
# 六、容量（36 可用内存约 12 GB，本栈估 2.5-4.5 GB 常驻）
# ---------------------------------------------------------------------------
# 上游默认 max_connections=200 / effective_cache_size=4096MB 是给 16GB+ 专用机的。
# 这里按"与既有栈共存"的实际取值收窄，压的是 PostgreSQL 的常驻。
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1024MB
# Celery worker 并发。上游默认 4；本实例只有一个 worker 容器，压到 2 够用。
CELERY_WORKER_AMOUNT=2

# ---------------------------------------------------------------------------
# 七、日志与语言
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_OUTPUT_FORMAT=text
LOG_TZ=Asia/Shanghai
LANG=C.UTF-8
LC_ALL=C.UTF-8
PYTHONIOENCODING=utf-8

# nginx
NGINX_CLIENT_MAX_BODY_SIZE=100M
NGINX_PROXY_READ_TIMEOUT=3600s
NGINX_PROXY_SEND_TIMEOUT=3600s

# 关掉对 updates.dify.ai 的升级检查外呼（本实例由我们按版本号手动升级）。
# 类型已核实：str，不是 bool。
CHECK_UPDATE_URL=
