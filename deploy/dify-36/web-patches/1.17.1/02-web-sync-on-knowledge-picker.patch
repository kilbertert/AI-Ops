index 00000000..9f02b422
--- /dev/null
+++ b/web/service/knowledge-sync.ts
@@ -0,0 +1,32 @@
+/* AI-Ops 知识库同步（ADR-0122）。
+ *
+ * 运营在 RAGFlow 建了一个库，它必须**自动**出现在 Dify 的「添加知识库」弹窗里，
+ * 不需要任何人跑命令。这个函数就是那一步：让网关把该租户的 RAGFlow 库收敛成
+ * external dataset。
+ *
+ * **它返回"建了几条"**，不是布尔：调用方只在有变化时刷新列表，否则每次打开弹窗
+ * 都多刷一次，列表会闪一下。
+ *
+ * 端点走 `/__aiops/` 前缀 —— 与知识库入口卡片同一个桥、同一套浏览器身份。
+ *
+ * **`workspace` 由页面带上来，而且它只回答"我这页看着是哪个 workspace"。**
+ * 这不是把判据交给前端：桥仍然要求一个有效的 Dify 会话，网关仍然按 workspace
+ * **反查**租户、并且拒绝请求里出现任何租户参数。前端能做的只有"我在哪一页"，
+ * 而它换出来的同步目标仍然由那个 workspace 对应的租户决定 —— 与
+ * `/__aiops/knowledge-open?workspace=…` 同一条规矩。
+ *
+ * 为什么不能省：桥自己的 `AIOPS_CONSOLE_BRIDGE_WORKSPACE_ID` 是**迁移期的静态
+ * 回退值**，不是"当前活跃 workspace"。用它会在多 workspace 部署里同步错租户，
+ * 而运营看到的却是自己那一页 —— 错误不会报，只会"新库没出现"。
+ */
+export const syncKnowledgeDatasets = async (workspaceId: string): Promise<number> => {
+  const query = workspaceId ? `?workspace=${encodeURIComponent(workspaceId)}` : ''
+  const response = await fetch(`/__aiops/knowledge-sync${query}`, {
+    method: 'POST',
+    credentials: 'include',
+    headers: { 'Content-Type': 'application/json' },
+  })
+  if (!response.ok) throw new Error(`knowledge sync failed: ${response.status}`)
+  const body = await response.json()
+  return typeof body?.created === 'number' ? body.created : 0
+}
