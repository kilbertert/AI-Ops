@@ -0,0 +1,23 @@
+/* AI-Ops 知识库同步（ADR-0122）。
+ *
+ * 运营在 RAGFlow 建了一个库，它必须**自动**出现在 Dify 的「添加知识库」弹窗里，
+ * 不需要任何人跑命令。这个函数就是那一步：让网关把该租户的 RAGFlow 库收敛成
+ * external dataset。
+ *
+ * **它返回"建了几条"**，不是布尔：调用方只在有变化时刷新列表，否则每次打开弹窗
+ * 都多刷一次，列表会闪一下。
+ *
+ * 端点走 `/__aiops/` 前缀 —— 与知识库入口卡片同一个桥、同一套浏览器身份。它
+ * **不接收任何租户或 workspace 参数**：租户由桥从 Cookie 里的 Dify 会话解析，
+ * 传了就等于让 URL 决定"同步哪个租户"。
+ */
+export const syncKnowledgeDatasets = async (): Promise<number> => {
+  const response = await fetch('/__aiops/knowledge-sync', {
+    method: 'POST',
+    credentials: 'include',
+    headers: { 'Content-Type': 'application/json' },
+  })
+  if (!response.ok) throw new Error(`knowledge sync failed: ${response.status}`)
+  const body = await response.json()
+  return typeof body?.created === 'number' ? body.created : 0
+}
