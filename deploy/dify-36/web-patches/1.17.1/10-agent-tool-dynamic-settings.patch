+import type { ToolValue } from '@/app/components/workflow/block-selector/types'
+import { screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { useState } from 'react'
+import { renderWorkflowFlowComponent } from '@/app/components/workflow/__tests__/workflow-test-env'
+import ToolSelector from '../index'
+
+const data = vi.hoisted(() => {
+  const tool = {
+    name: 'consumer_knowledge',
+    parameters: [
+      {
+        name: 'knowledge_base_ids',
+        form: 'form',
+        type: 'dynamic-select',
+        multiple: true,
+        required: true,
+        label: { en_US: 'Knowledge bases', zh_Hans: '检索知识库' },
+      },
+    ],
+  }
+  const provider = {
+    id: 'trendpower/consumer_knowledge/consumer_knowledge',
+    name: 'trendpower/consumer_knowledge/consumer_knowledge',
+    plugin_id: 'trendpower/consumer_knowledge',
+    is_team_authorization: true,
+    tools: [tool],
+  }
+  return { tool, provider, fetch: vi.fn(), change: vi.fn(), identity: vi.fn() }
+})
+vi.mock('@/app/components/header/account-setting/model-provider-page/hooks', () => ({
+  useLanguage: () => 'zh_Hans',
+}))
+vi.mock('@/app/components/workflow/nodes/_base/hooks/use-available-var-list', () => ({
+  default: () => ({ availableVars: [], availableNodesWithParent: [] }),
+}))
+vi.mock('@/service/use-plugins', async (original) => ({
+  ...(await original()),
+  useInvalidateInstalledPluginList: () => vi.fn(),
+  useFetchDynamicOptions: (...args: unknown[]) => {
+    data.identity(...args)
+    return { mutateAsync: data.fetch }
+  },
+}))
+vi.mock('../components/tool-authorization-section', () => ({
+  ToolAuthorizationSection: () => null,
+}))
+vi.mock('../components/tool-base-form', () => ({ ToolBaseForm: () => null }))
+vi.mock('@/service/use-tools', () => ({
+  useAllBuiltInTools: () => ({ data: [data.provider], isFetched: true }),
+  useAllCustomTools: () => ({ data: [], isFetched: true }),
+  useAllWorkflowTools: () => ({ data: [], isFetched: true }),
+  useAllMCPTools: () => ({ data: [], isFetched: true }),
+  useInvalidateAllBuiltInTools: () => vi.fn(),
+}))
+vi.mock('../hooks/use-plugin-installed-check', () => ({
+  usePluginInstalledCheck: () => ({ inMarketPlace: false, manifest: undefined, pluginID: '' }),
+}))
+
+it.each(['legacy', 'wrapped'])(
+  'loads knowledge options and preserves %s settings through the real selector hook',
+  async (shape) => {
+    data.fetch.mockClear()
+    data.change.mockClear()
+    data.identity.mockClear()
+    const user = userEvent.setup()
+    data.fetch.mockResolvedValue({
+      options: [
+        { value: 'kb-1', label: { en_US: 'Guide', zh_Hans: '充电指南' }, show_on: [] },
+        { value: 'kb-2', label: { en_US: 'Billing', zh_Hans: '账单说明' }, show_on: [] },
+      ],
+    })
+    function Harness() {
+      const field = { type: 'constant', value: ['kb-1'] }
+      const [value, setValue] = useState<ToolValue>({
+        provider_name: data.provider.name,
+        tool_name: data.tool.name,
+        tool_label: data.tool.name,
+        enabled: true,
+        type: 'builtin',
+        parameters: {},
+        settings: { knowledge_base_ids: shape === 'legacy' ? field : { value: field } },
+      })
+      return (
+        <ToolSelector
+          value={value}
+          isEdit
+          nodeId="node-1"
+          onSelect={(next) => {
+            data.change(next)
+            setValue(next)
+          }}
+          nodeOutputVars={[]}
+          availableNodes={[]}
+        />
+      )
+    }
+    renderWorkflowFlowComponent(<Harness />, { edges: [], nodes: [] })
+    await user.click(screen.getByRole('button', { name: 'consumer_knowledge' }))
+    await waitFor(() => expect(data.fetch).toHaveBeenCalledTimes(1))
+    expect(data.identity).toHaveBeenCalledWith(
+      data.provider.plugin_id,
+      data.provider.name,
+      data.tool.name,
+      'knowledge_base_ids',
+      'tool',
+      undefined,
+    )
+    const select = screen.getByRole('combobox', { name: '充电指南' })
+    await user.click(select)
+    expect(screen.getByRole('option', { name: '充电指南' })).toBeInTheDocument()
+    await user.click(screen.getByRole('option', { name: '账单说明' }))
+    const field = { type: 'constant', value: ['kb-1', 'kb-2'] }
+    expect(data.change.mock.lastCall?.[0].settings).toEqual({
+      knowledge_base_ids: shape === 'legacy' ? field : { value: field },
+    })
+  },
+)
