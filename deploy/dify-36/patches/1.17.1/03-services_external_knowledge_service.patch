+#: Marks a value that was encrypted at rest by :func:`_encrypt_api_key`.
+#: A settings blob without it is legacy plaintext and stays readable, so the
+#: migration can be done row by row instead of as one breaking sweep.
+_ENCRYPTED_PREFIX = "enc:v1:"
+
+
+def _encrypt_api_key(tenant_id: str, api_key: str) -> str:
+    return f"{_ENCRYPTED_PREFIX}{encrypt_token(tenant_id, api_key)}"
+
+
+def _decrypt_api_key(tenant_id: str, value: str) -> str:
+    if not value.startswith(_ENCRYPTED_PREFIX):
+        return value
+    try:
+        return decrypt_token(tenant_id, value[len(_ENCRYPTED_PREFIX) :])
+    except Exception as exc:
+        # Fail loudly rather than fall back to the raw value: sending ciphertext as
+        # a Bearer token looks exactly like "the provider rejected our key", which
+        # is the wrong trail to leave. The known cause is a legacy row whose
+        # plaintext happens to start with the prefix; the migration encrypts those.
+        raise ValueError(
+            f"cannot decrypt stored api_key for tenant {tenant_id}; "
+            "run the 20261020 migration or re-enter the key in the console"
+        ) from exc
+
+
+def external_api_settings(external_knowledge_api: ExternalKnowledgeApis) -> dict[str, Any]:
+    """Return an API template's settings with ``api_key`` decrypted.
+
+    Why centralise this: ``settings`` is a plain JSON text column, and its
+    ``api_key`` is a real credential for a third-party endpoint. Leaving it in
+    cleartext means every database dump exposes it, so it is stored via Dify's
+    own tenant-scoped key provider. Every read path must therefore decrypt —
+    reading the raw column would silently send the ciphertext as a Bearer token.
+    """
+    settings: dict[str, Any] = json.loads(external_knowledge_api.settings or "{}")
+    api_key = settings.get("api_key")
+    if isinstance(api_key, str) and api_key:
+        settings["api_key"] = _decrypt_api_key(external_knowledge_api.tenant_id, api_key)
+    return settings
+
