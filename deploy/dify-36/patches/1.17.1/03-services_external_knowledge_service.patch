+    def settings_for_storage(tenant_id: str, settings: dict[str, Any]) -> dict[str, Any]:
+        """Copy of ``settings`` with ``api_key`` encrypted for the database.
+
+        The API template's key is a live credential for a third-party endpoint;
+        Dify stores it in a plain JSON text column upstream. Encrypting it with
+        the tenant's own key provider keeps database dumps from handing it out,
+        at the cost that every read path must go through
+        :func:`external_api_settings`.
+
+        ``settings`` here is always **plaintext** — what the operator typed, or
+        what a decrypted read produced. Do not sniff for the prefix to skip
+        encryption: a provider is free to issue a key that literally starts with
+        ``enc:v1:``, and treating it as already-encrypted would store it verbatim
+        and then fail to decrypt it on every later read. Callers that hold a
+        stored value must decrypt first (see :func:`external_api_settings`).
+        """
+        stored = dict(settings)
+        api_key = stored.get("api_key")
+        if isinstance(api_key, str) and api_key:
+            stored["api_key"] = _encrypt_api_key(tenant_id, api_key)
+        return stored
+
+    @staticmethod
