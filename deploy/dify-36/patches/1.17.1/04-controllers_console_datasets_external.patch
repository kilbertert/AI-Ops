+    #: Whether this particular response may carry the decrypted key. The list
+    #: endpoint has no edit-permission check, so it passes ``False``: every member
+    #: of the workspace can read that response, and the third-party key is not
+    #: theirs to see. The single-template GET is what the edit form pre-fills
+    #: from, and that one passes ``True``.
+    reveal_api_key: bool = True
+
+    @property
+    def settings_dict(self) -> dict[str, Any] | None:
+        # The stored ``settings`` blob carries an encrypted ``api_key`` (see
+        # ``ExternalDatasetService.settings_for_storage``). The console pre-fills
+        # its edit form from this response and echoes ``[__HIDDEN__]`` back when
+        # the operator leaves the key untouched, so it must see the plaintext —
+        # but only on the endpoint that is allowed to show it.
+        settings = ExternalDatasetService.settings_for_display(self.external_knowledge_api)
+        if settings is None:
+            return None
+        if not self.reveal_api_key and settings.get("api_key"):
+            settings["api_key"] = HIDDEN_VALUE
+        return settings
 
