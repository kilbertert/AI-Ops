# 独立非特权 nginx，由项目服务管理；不改共享 nginx 的启动顺序。
pid ${AIOPS_NODE_STATE}/callback.pid;
error_log stderr;
events { worker_connections 128; }
http {
access_log off;
client_body_temp_path ${AIOPS_NODE_STATE}/client-temp;
proxy_temp_path ${AIOPS_NODE_STATE}/proxy-temp;
server {
    listen ${AIOPS_NODE_BRIDGE}:8788 ssl;
    ssl_certificate ${AIOPS_NODE_CONFIG}/tls/callback/server.crt;
    ssl_certificate_key ${AIOPS_NODE_CONFIG}/tls/callback/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_name _;
    client_max_body_size 64k;
    location ~ ^/v1/internal/charging-status/(execution-config|claims|completions)/run_[A-Za-z0-9_-]+$ {
        limit_except POST { deny all; }
        proxy_pass ${AIOPS_PRODUCTION_GATEWAY};
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-AI-Ops-Exec-Config $http_x_ai_ops_exec_config;
        proxy_set_header Content-Type $http_content_type;
        proxy_read_timeout 45s;
        proxy_buffering off;
    }
    location / { return 404; }
    location = /v1/internal/execution-node/capabilities {
        limit_except POST { deny all; }
        proxy_pass ${AIOPS_PRODUCTION_GATEWAY};
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Content-Type $http_content_type;
        proxy_read_timeout 15s;
    }
    location ~ ^/v1/internal/operator-runs/run_[A-Za-z0-9_-]+/(completions|tools/(cpms_order_detail|cpms_charging_samples)/(authorization|evidence))$ {
        limit_except POST { deny all; }
        client_max_body_size 256k;
        proxy_pass ${AIOPS_PRODUCTION_GATEWAY};
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-AI-Ops-Exec-Config $http_x_ai_ops_exec_config;
        proxy_set_header Content-Type $http_content_type;
        proxy_read_timeout 45s;
        proxy_buffering off;
    }
    location ~ ^/v1/internal/operator-runs/run_[A-Za-z0-9_-]+/cpms/(chOrderInfo/getOrderInfoDetail|iotChargingDevice/getChargingMonitor)/[A-Za-z0-9_-]+$ {
        limit_except GET { deny all; }
        proxy_pass ${AIOPS_PRODUCTION_GATEWAY};
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 45s;
        proxy_buffering off;
    }
}
}
