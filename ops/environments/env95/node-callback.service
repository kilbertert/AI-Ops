[Unit]
Description=AI-Ops environment 95 execution callback
Requires=aiops95-node-runtime.service
After=aiops95-node-runtime.service
PartOf=aiops95-node-runtime.service

[Service]
Type=simple
User=aiops
Group=aiops
ExecStartPre=/usr/bin/nginx -e stderr -t -c /etc/aiops-node-runtime/gateway-callback.conf
ExecStart=/usr/bin/nginx -e stderr -c /etc/aiops-node-runtime/gateway-callback.conf -g "daemon off;"
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
