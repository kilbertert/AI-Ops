# Dify 登录代理的部署配置（#778 / ADR-0023）。**密钥只放这里，不进仓库、不进命令行。**
# 装到 /etc/aiops-login-proxy/login-proxy.env，权限 0600 root:aiopslogin。

# ── 对外入口（TLS 硬前置）───────────────────────────────────────────────────
# 浏览器实际访问的**控制台公开源**。必须以 https:// 开头 —— 公司密码不得经明文传输，
# 代理在启动时自检，不满足即**拒绝服务**（不是降级跑起来）。
AIOPS_LOGIN_PROXY_PUBLIC_ORIGIN=https://<dify 控制台域名>

# 只监听回环；宿主 nginx 同源反代。
AIOPS_LOGIN_PROXY_HOST=127.0.0.1
AIOPS_LOGIN_PROXY_PORT=10119

# ── 公司 UPMS ──────────────────────────────────────────────────────────────
AIOPS_LOGIN_PROXY_COMPANY_URL=https://<公司网关根>
# 密码的 AES key = 公司 Nacos `security.encode.key`（16 字节）。**必须与目标环境一致**：
# 拿错 key 不会报错，会得到一个看似成功的乱码，表现为"密码错误"。
#
# ⚠️ **不要填源码里的默认值**。`PasswordDecoderFilter` 声明的是
# `@Value("${security.encode.key:<源码默认>}")`，而**生产用的不是那个默认值**
# （2026-10-16 实测：用默认值发出的密文被生产网关解成乱码 ⇒ 表现为"密码错误"）。
#
# 怎么确定真值（不写进仓库，见运维记录）：从管理后台登录页抓一次真实请求，
# 取 query string 里的 `password` 密文，用候选 key 复现它 —— key == IV ⇒ 加解密是
# **确定性**的，唯一能复现出同一密文的候选就是真值。判错的表现与"密码错误"完全一样，
# 所以**不要靠试密码**，要靠复现密文。
AIOPS_LOGIN_PROXY_COMPANY_AES_KEY=<16 字节>
# 登录与读权限码用的 client-type。公司侧按它取角色；**未知值得到空角色集**（表现为无权限），
# 所以这个值必须与 #777 建的角色所属 client_type 一致。
AIOPS_LOGIN_PROXY_COMPANY_CLIENT_TYPE=admin
# 可选：读 /user/info 用另一个 client-type（不与登录共用时填）。
AIOPS_LOGIN_PROXY_COMPANY_INFO_CLIENT_TYPE=
# 可选：公司网关要求的 Basic 头（`Authorization: Basic …`）。
AIOPS_LOGIN_PROXY_COMPANY_BASIC_AUTH=

# ── Dify 控制台 ────────────────────────────────────────────────────────────
# ── 本部署的环境标识（必填；#864 / ADR-0061）────────────────────────────────
# 它是 Dify 账号邮箱的一部分（`{environment}-{公司用户id}@aiops-login.invalid`）。
# 41 与 95 是两套独立 UPMS，`sys_user.id` 各自生成；**不带这个前缀时，两套环境里
# id 相同的两个不同的人会映射到同一个 Dify 账号**（账号是全局的），
# 于是第二个环境的代理能为它签会话、进第一个环境的 workspace —— 那是越权。
#
# ⚠️ **必填，没有默认值**：漏配时代理会**拒绝启动**。这是故意的 ——
# 给默认值会让漏配静默退化回"只按 id"，而那时启动、登录、审计全都正常。
# 只接受规范形式：小写字母/数字/`-`/`_`，字母或数字开头结尾，≤32 字符。
# **不做字符归一化** —— `prod.41` 与 `prod/41` 归一化后会同为 `prod-41`，
# 两个部署仍会撞到同一个 Dify 账号。所以非规范写法直接报错，请改配置。
AIOPS_LOGIN_PROXY_ENVIRONMENT=

AIOPS_LOGIN_PROXY_DIFY_URL=http://127.0.0.1:10018
# Dify 的 SECRET_KEY。**这把 key 是 ADR-0023 被接受代价的核心**：它能签任何 Dify 账号的
# 会话，且同时保护 Dify 库里的工具/模型凭据。轮换步骤见 ADR-0023。
AIOPS_LOGIN_PROXY_DIFY_SECRET_KEY=<Dify SECRET_KEY>
AIOPS_LOGIN_PROXY_DIFY_EDITION=COMMUNITY
# 自签会话的有效期（分钟）。撤权后最晚这么久失效。
AIOPS_LOGIN_PROXY_ACCESS_MINUTES=60
# 应急 owner 的 **Dify 账号 id**（开户需要 owner 会话，而 owner 会话也是自签得到的，
# 所以这里**不需要** owner 的密码）。用 members 接口查它的 id。
AIOPS_LOGIN_PROXY_DIFY_OWNER_ACCOUNT_ID=

# ── 权限码（#777 给出生产值）──────────────────────────────────────────────
AIOPS_LOGIN_PROXY_EDIT_PERMISSION=aiops:agent:edit
AIOPS_LOGIN_PROXY_PUBLISH_PERMISSION=aiops:agent:publish

# 映射表与审计数据目录。
AIOPS_LOGIN_PROXY_DATA_DIR=/var/lib/aiops-login-proxy

# 失败退避：同一来源/账号在窗口内失败达阈即拒绝。
AIOPS_LOGIN_PROXY_BACKOFF_THRESHOLD=5
AIOPS_LOGIN_PROXY_BACKOFF_WINDOW=300

# —— 按租户开户（#883）：**四键成对**，全空 = 维持单一固定工作区（V1 暂定） ——
# 代理不自己存 workspace 映射：它问网关（「一份真值」），再经 inner_api 把人 join 进去。
# 建 workspace 不在这里（建与写映射必须同机同一次运行 → `aiops-admin ensure-workspace`）。
#
# ⚠️ `GATEWAY_URL` 是**那个环境的公网入口**（如 `https://api.mall.qushiyun.com`），
# **不是**网关主机的本机地址。代理跑在 Dify 主机（36），网关跑在租户环境主机（41），
# 两者只有公网可达 —— `172.18.0.1` 在两台机器上都是**各自**的 docker 网桥，填它只会在
# 本机绕圈然后超时（2026-10-22 就是这样把登录打挂的）。
#
# 为什么不是 SSH 隧道：同机上已有的发布桥（`AIOPS_CONSOLE_BRIDGE_GATEWAY_URL`）走的就是
# 同一个公网入口。给同一个跳转拉第二套传输，只会让"加一个环境"变成一次主机运维动作，
# 而多租户本来就要按环境线性增长。隧道只在公网**根本不可达**时才成立（41→36 的 inner_api
# 是那种情形：Dify 的 5001 不对外发布）。
AIOPS_LOGIN_PROXY_GATEWAY_URL=
AIOPS_LOGIN_PROXY_GATEWAY_INTERNAL_TOKEN=
AIOPS_LOGIN_PROXY_INNER_API_BASE_URL=
AIOPS_LOGIN_PROXY_INNER_API_KEY=

# 管家节点试用的独立交换密钥，留空关闭；与Gateway对应键相同，至少32随机字符。
# 仅在HTTPS精确路径限制网关来源后配置；不复用发布、工具或整租户密钥。
AIOPS_LOGIN_PROXY_OPERATOR_TRIAL_KEY=
