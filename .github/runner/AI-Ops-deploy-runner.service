[Unit]
Description=AI-Ops dedicated deployment runner
After=network-online.target
Wants=network-online.target

[Service]
MemoryHigh=1G
MemoryMax=2G
CPUWeight=200
WorkingDirectory=%h/Projects/_runners/AI-Ops-deploy-runner
ExecStart=%h/Projects/_runners/AI-Ops-deploy-runner/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin

[Install]
WantedBy=default.target
