    {
      "name": "cpms_station_plan",
      "description": "Compare one continuous charging session at an explicitly named visible station. Extract name, date YYYY-MM-DD, start/end HH:mm, energy kWh and power kW from the user. Missing conditions return a clarification. Rates are read from CPMS, never invent them. basis must be the user-confirmed 普通按量、不用优惠、不预约、不买保险、充完离场; timezone is the user-confirmed IANA billing timezone.",
      "inputs": [
        "name",
        "date",
        "start",
        "end",
        "energy",
        "power",
        "basis",
        "timezone"
      ],
      "model_inputs": [
        "name",
        "date",
        "start",
        "end",
        "energy",
        "power",
        "basis",
        "timezone"
      ],
      "applies_to": [
        "operator_conversation"
      ],
      "request": {
        "method": "GET",
        "path_template": "/station-plan",
        "query": [
          {
            "name": "name",
            "from": "name"
          },
          {
            "name": "date",
            "from": "date"
          },
          {
            "name": "start",
            "from": "start"
          },
          {
            "name": "end",
            "from": "end"
          },
          {
            "name": "energy",
            "from": "energy"
          },
          {
            "name": "power",
