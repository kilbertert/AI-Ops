{
  "schema": "aiops-operator-tools/1",
  "_comment": [
    "CPMS只读工具的唯一声明；模型可提出业务参数，身份、对象权限、请求地址与证据投影由系统校验。",
    "applies_to保留工具数据对象类别，不决定管家本轮意图；统一管家循环可声明全部CPMS工具。"
  ],
  "tools": [
    {
      "name": "cpms_order_detail",
      "description": "Read diagnostic fields for the authorized order from CPMS. Optional order_no is a candidate supplied by the user or the current conversation; authorization is checked for each call.",
      "inputs": [
        "order_no"
      ],
      "request": {
        "method": "GET",
        "path_template": "/chOrderInfo/getOrderInfoDetail/{order_no}",
        "query": []
      },
      "source": "cpms.orderDetail",
      "response": {
        "kind": "single",
        "row_path": "chOrderInfoModel",
        "require_envelope_identity": true
      },
      "evidence_fields": [
        "orderNo",
        "siteId",
        "deviceId",
        "childDeviceId",
        "deviceCode",
        "childDeviceCode",
        "deviceProtocol",
        "status",
        "createdTime",
        "stopTime",
        "stoppedReasonCode",
        "stoppedReasonContent",
        "electricity",
        "time",
        "voltage",
        "isPrePay",
        "prePayAmount",
        "electricityFee",
        "serviceFee",
        "dsElectricFee",
        "dsServiceFee",
        "launchFee",
        "marketAmount",
        "vat",
        "vatFee",
        "totalAmount",
        "payAmount",
        "payTime",
        "occupyFee",
        "refundStatus",
        "refundAmount",
        "startSoc",
        "endSoc",
        "gunPower",
        "interfaceType",
        "launchType",
        "type",
        "packageType",
        "parkFee",
        "tipElectricity",
        "peakElectricity",
        "flatElectricity",
        "valleyElectricity"
      ],
      "applies_to": [
        "order"
      ],
      "model_inputs": [
        "order_no"
      ]
    },
    {
      "name": "cpms_charging_samples",
      "description": "Read up to 50 CPMS charging samples for the authorized order. Ordering and completeness are not guaranteed. Optional order_no is a candidate supplied by the user or the current conversation; authorization is checked for each call.",
      "inputs": [
        "order_no"
      ],
      "request": {
        "method": "GET",
        "path_template": "/iotChargingDevice/getChargingMonitor/{order_no}",
        "query": [
          {
            "name": "current",
            "value": "1"
          },
          {
            "name": "size",
            "value": "50"
          }
        ]
      },
      "source": "cpms.chargingMonitor",
      "response": {
        "kind": "page",
        "row_path": "records",
        "page_size": 50,
        "flags": {
          "sample_limit": 50,
          "ordering_guaranteed": false,
          "complete_timeline": false,
          "absence_when_empty": "no_samples"
        }
      },
      "evidence_fields": [
        "orderNo",
        "siteId",
        "deviceId",
        "childDeviceId",
        "createdTime",
        "power",
        "voltage",
        "current",
        "chargingElectricityQuantity",
        "soc",
        "temperature",
        "batteryMaxTemperature",
        "batteryMinTemperature"
      ],
      "applies_to": [
        "order"
      ],
      "model_inputs": [
        "order_no"
      ]
    },
    {
      "name": "cpms_site_search",
      "description": "Search charging sites visible to this account. Extract complete place keywords BEFORE calling: 广州天河 -> address_terms [\"广州\",\"天河\"]. Do not concatenate place levels or invent words. Empty terms list visible sites; names and counts come from returned evidence.",
      "inputs": [
        "name",
        "address",
        "address_terms"
      ],
      "applies_to": [
        "conversation"
      ],
      "request": {
        "method": "GET",
        "path_template": "/chSite/page",
        "query": [
          {
            "name": "current",
            "value": "1"
          },
          {
            "name": "size",
            "value": "50"
          },
          {
            "name": "type",
            "value": "0"
          },
          {
            "name": "name",
            "from": "name"
          },
          {
            "name": "address",
            "from": "address"
          },
          {
            "name": "address_terms",
            "from": "address_terms"
          }
        ]
      },
      "source": "cpms.sitePage",
      "response": {
        "kind": "page",
        "row_path": "records",
        "page_size": 50,
        "flags": {
          "sample_limit": 50,
          "ordering_guaranteed": false,
          "complete_timeline": false,
          "absence_when_empty": "no_samples"
        }
      },
      "evidence_fields": [
        "id",
        "name",
        "address"
      ],
      "model_inputs": [
        "name",
        "address_terms"
      ],
      "model_input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "address_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 4
          }
        },
        "required": [
          "address_terms"
        ],
        "additionalProperties": false
      }
    },
    {
