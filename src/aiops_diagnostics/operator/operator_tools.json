    {
      "name": "cpms_order_amount_check",
      "description": "Verify recorded order amounts against historical tariff and billing evidence read in this run. Read detail, tariff and billing first. No input amounts; read-only, does not recalculate the stored bill. Each check is local arithmetic only: matching amounts do NOT prove no overcharge, correct original metering or discount eligibility. State the conclusion and limitations together.",
      "inputs": [
        "order_no"
      ],
      "model_inputs": [],
      "applies_to": [
        "order"
