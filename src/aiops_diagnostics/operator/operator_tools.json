{
  "schema": "aiops-operator-tools/1",
  "_comment": [
    "一个 CPMS 只读工具是什么 —— 仓内唯一声明。",
    "网关侧的路径物化、输入、证据字段、来源标记、发布白名单与 provider 的 OpenAPI 生成，",
    "以及节点侧的装配，都从这里读或由它校验。新增一个工具只加一条，不改节点源码。",
    "边界（有意为之）：request 只能是 GET + 相对路径 + 声明里的查询参数表；",
    "response.kind支持single、page与object；object的有界嵌套白名单由evidence_shape声明。",
    "applies_to 说明这个工具能出现在哪一类运行里：order（有订单的诊断）与 conversation（无订单回合）。",
    "model_inputs 是模型可以提议的那部分输入 —— 它决定发布清单里的 input_schema。运行绑定的输入（例如订单号）不出现在 schema 里：模型不能选它。"
  ],
  "tools": [
    {
      "name": "cpms_order_detail",
      "description": "Read diagnostic fields for the authorized order from CPMS. Takes no arguments.",
      "inputs": [
        "order_no"
      ],
      "request": {
        "method": "GET",
        "path_template": "/chOrderInfo/getOrderInfoDetail/{order_no}",
        "query": []
      },
      "source": "cpms.orderDetail",
      "response": {
        "kind": "single",
        "row_path": "chOrderInfoModel",
        "require_envelope_identity": true
      },
      "evidence_fields": [
        "orderNo",
        "siteId",
        "deviceId",
        "childDeviceId",
        "deviceCode",
        "childDeviceCode",
        "deviceProtocol",
        "status",
        "createdTime",
        "stopTime",
        "stoppedReasonCode",
        "stoppedReasonContent",
        "electricity",
        "time",
        "voltage",
        "isPrePay",
        "prePayAmount",
        "electricityFee",
        "serviceFee",
        "dsElectricFee",
        "dsServiceFee",
        "launchFee",
        "marketAmount",
        "vat",
        "vatFee",
        "totalAmount",
        "payAmount",
        "payTime",
        "occupyFee",
        "refundStatus",
        "refundAmount",
        "startSoc",
        "endSoc",
        "gunPower",
        "interfaceType",
        "launchType",
        "type",
        "packageType",
        "parkFee",
        "tipElectricity",
        "peakElectricity",
        "flatElectricity",
        "valleyElectricity"
      ],
      "applies_to": [
        "order"
      ],
      "model_inputs": []
    },
    {
      "name": "cpms_charging_samples",
      "description": "Read up to 50 CPMS charging samples for the authorized order. Ordering and completeness are not guaranteed. Takes no arguments.",
      "inputs": [
        "order_no"
      ],
      "request": {
        "method": "GET",
        "path_template": "/iotChargingDevice/getChargingMonitor/{order_no}",
        "query": [
          {
            "name": "current",
            "value": "1"
          },
          {
            "name": "size",
            "value": "50"
          }
        ]
      },
      "source": "cpms.chargingMonitor",
      "response": {
        "kind": "page",
        "row_path": "records",
        "page_size": 50,
        "flags": {
          "sample_limit": 50,
          "ordering_guaranteed": false,
          "complete_timeline": false,
          "absence_when_empty": "no_samples"
        }
      },
      "evidence_fields": [
        "orderNo",
        "siteId",
        "deviceId",
        "childDeviceId",
        "createdTime",
        "power",
        "voltage",
        "current",
        "chargingElectricityQuantity",
        "soc",
        "temperature",
        "batteryMaxTemperature",
        "batteryMinTemperature"
      ],
      "applies_to": [
        "order"
      ],
      "model_inputs": []
    },
    {
      "name": "cpms_site_search",
      "description": "Search charging sites visible to this account. Extract complete place keywords BEFORE calling: 广州天河 -> address_terms [\"广州\",\"天河\"]. Do not concatenate place levels or invent words. Empty terms list visible sites; names and counts come from returned evidence.",
      "inputs": [
        "name",
        "address",
        "address_terms"
      ],
      "applies_to": [
        "conversation"
      ],
      "request": {
        "method": "GET",
        "path_template": "/chSite/page",
        "query": [
          {
            "name": "current",
            "value": "1"
          },
          {
            "name": "size",
            "value": "50"
          },
          {
            "name": "type",
            "value": "0"
          },
          {
            "name": "name",
            "from": "name"
          },
          {
            "name": "address",
            "from": "address"
          },
          {
            "name": "address_terms",
            "from": "address_terms"
          }
        ]
      },
      "source": "cpms.sitePage",
      "response": {
        "kind": "page",
        "row_path": "records",
        "page_size": 50,
        "flags": {
          "sample_limit": 50,
          "ordering_guaranteed": false,
          "complete_timeline": false,
          "absence_when_empty": "no_samples"
        }
      },
      "evidence_fields": [
        "id",
        "name",
        "address"
      ],
      "model_inputs": [
        "name",
        "address_terms"
      ],
      "model_input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "address_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 4
          }
        },
        "required": [
          "address_terms"
        ],
        "additionalProperties": false
      }
    },
    {
