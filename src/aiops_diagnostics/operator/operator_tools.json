    {
      "name": "cpms_order_billing",
      "description": "Read authorized order billing. dsElectricFee/dsServiceFee are electricity-loss charges (电损电费/电损服务费), NOT discounts. marketAmount is recorded total reduction; discounts contains recorded terms only. Empty discounts does not prove no eligibility. Currency is not supplied: never infer yuan. Read order detail and historical tariff first. order_no optionally selects a user-referenced order; Gateway checks authorization.",
      "inputs": [
        "order_no"
      ],
      "model_inputs": [
        "order_no"
      ],
      "applies_to": [
        "order"
      ],
      "request": {
        "method": "GET",
        "path_template": "/chOrderInfo/{order_no}",
        "query": []
      },
      "source": "cpms.orderBilling",
      "response": {
        "kind": "object",
        "row_path": "data"
      },
      "evidence_fields": [
        "orderNo",
        "siteId",
        "serviceFee",
        "dsServiceFee",
