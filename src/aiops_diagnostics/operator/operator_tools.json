          },
          {
            "name": "basis",
            "from": "basis"
          },
          {
            "name": "timezone",
            "from": "timezone"
          }
        ]
      },
      "source": "cpms.stationPlan",
      "response": {
        "kind": "object",
        "row_path": "data"
      },
      "evidence_fields": [
        "text",
        "site_id",
        "date",
        "name",
        "start",
